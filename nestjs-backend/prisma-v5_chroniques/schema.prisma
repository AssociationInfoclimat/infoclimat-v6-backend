generator client {
  provider = "prisma-client-js"
  output   = "../prisma-v5_chroniques/v5-chroniques-database-client-types"
}

datasource v5_chroniques {
  provider = "mysql"
  url      = env("V5_CHRONIQUES_DATABASE_URL")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model actualites {
  id                Int             @id @default(autoincrement()) @v5_chroniques.UnsignedInt
  dh_pub            DateTime        @v5_chroniques.DateTime(0)
  dh_modif          DateTime        @v5_chroniques.DateTime(0)
  dh_ouverture      DateTime?       @v5_chroniques.DateTime(0)
  titre             String          @v5_chroniques.LongText
  id_auteur         Int             @v5_chroniques.UnsignedInt
  pseudo            String          @v5_chroniques.VarChar(255)
  contenu           String          @v5_chroniques.LongText
  type              actualites_type
  md5xml            String?         @v5_chroniques.VarChar(255)
  bqs_day           DateTime?       @v5_chroniques.Date
  bim_end           DateTime?       @v5_chroniques.Date
  indice_importance Int             @default(0)
  image_header      String?         @v5_chroniques.VarChar(255)

}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
