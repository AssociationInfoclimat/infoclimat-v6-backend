
SALT_AUTH_KEY="*******" # for cookie salt
SALT_OLD_AUTH_METHOD_PASSWORD_KEY="*******" # for pw salt (login for old accounts)
SALT_PROFILE_PIC="*******" # for pp salt

# Path to fetch appli.txt and forums.txt that are filled by other apps (to give a connected users counter)
PATH_TO_APP_LIVE_USER_COUNTERS=/var/www/example-domain.fr/path/to/

#
# "V5_data_params" db
V5_DATA_PARAMS_DATABASE_URL=mysql://root:example@localhost:3306/V5_data_params?schema=public

# 
# "V5" db
V5_DATABASE_URL=mysql://root:example@localhost:3306/V5?schema=public

# 
# "V5_prevs" db
V5_PREVS_DATABASE_URL=mysql://root:example@localhost:3306/V5_prevs?schema=public

# 
# "V5_photolive" db
V5_PHOTOLIVE_DATABASE_URL=mysql://root:example@localhost:3306/V5_photolive?schema=public

# 
# "dico" db
DICO_DATABASE_URL=mysql://root:example@localhost:3306/dico?schema=public

# 
# "V5_chroniques" db
V5_CHRONIQUES_DATABASE_URL=mysql://root:example@localhost:3306/V5_chroniques?schema=public

# Dynamic credentials for database per year (for "V5_data_xxxx" databases):
#  ("YYYY" is replaced by year on-demand)
DATABASE_V5_PER_YEAR_URL=mysql://root:example@localhost:3306/V5_data_YYYY?schema=public

# Redis Cache 
REDIS_CACHE_HOST=127.0.0.1

# Set the path to the tiles:
TUILES_CHEMINS=../demo-tuiles

# Base URL of IC api
# We use it each time we need to get data directly from legacy API:
IC_LEGACY_API_URL=https://www.infoclimat.fr/api

# Each time we need to inject old /include raw html from ic legacy
IC_LEGACY_API_URL=https://www.infoclimat.fr

# Base URL of the API
HOST=http://localhost:3000/

#
# It looks like somehow %day% and %hour% are not always in the same order ???
STATIONS_METEO_PATTERN_TILES_KEY="SOME %param%%year%%month% SECRET %hour%%day% TOKEN"


# Path to the sqlite data ROOT directory.
# In prod it was something like `const TILES_PATH = '/media/dat[...]infoclimat.net/tiles';`
#  but in dev we copy these files into `./sqlite-data`
TILES_PATH=./sqlite-data